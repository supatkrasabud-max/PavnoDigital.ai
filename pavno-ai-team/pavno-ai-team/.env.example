# ---- LINE (LINE Developers > Messaging API)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=          # พิมพ์ groupid ในกลุ่ม แล้วนำค่ามาใส่
CEO_USER_ID=            # พิมพ์ myid แล้วนำค่ามาใส่ (ผู้เดียวที่อนุมัติงบ/บันทึกเงินทุนได้)
ALLOWED_USER_IDS=       # (ไม่บังคับ) user id ที่สั่งงานได้ คั่นด้วย ,

# ---- Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
MODEL_LEAD=claude-sonnet-5-5
MODEL_WORKER=claude-haiku-5-5

# ---- สมุดบัญชี
LEDGER_BACKEND=sheets   # sheets = Google Sheets, csv = ทดสอบในเครื่อง
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=   # วางเนื้อหาไฟล์ JSON ของ service account ทั้งก้อน (บรรทัดเดียว)

# ---- Stripe
STRIPE_WEBHOOK_SECRET=
NOTIFY_EACH_SALE=false  # true = แจ้งทุกออเดอร์ในกลุ่ม (กินโควตา push 300 ข้อความ/เดือน)

# ---- รายงานอัตโนมัติ
