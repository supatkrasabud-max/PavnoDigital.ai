# Configuration template only. The current static demo does not read these values yet.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Required only when enabling visitor statistics. Set these in Vercel, not in dist/.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_VERCEL_ONLY
PAVNO_ANALYTICS_DASHBOARD_KEY=REPLACE_WITH_A_LONG_PRIVATE_PASSWORD
# Never put a secret/service_role key or dashboard key in browser code.
# Required for file delivery after payment (api/download.js). Set these in Vercel only.
# Stripe restricted key with Read access to Checkout Sessions and Payment Links.
STRIPE_SECRET_KEY=REPLACE_IN_VERCEL_ONLY
# JSON: product id -> download link, or a list of {"label","url"} when a product has several files.
DOWNLOAD_LINKS={"thai-abc":"https://drive.google.com/REPLACE_ME"}
